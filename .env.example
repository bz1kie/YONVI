DATABASE_URL=postgresql://yorvi:yorvi_local_password@localhost:5432/yorvi
PORT=3001
WEB_ORIGIN=http://localhost:5173

# OFF by default. Never enable demo authentication on a public server.
ALLOW_DEMO_AUTH=false

# Runtime secret for the MAX Mini App login (SERVER ONLY).
# Use MAX_YONVI_TOKEN on the server, or the legacy MAX_BOT_TOKEN.
# Do NOT prefix with VITE_ and never commit an actual token.
# MAX_YONVI_TOKEN=replace-with-token-from-business.max.ru
# NODE_ENV=production
