# Northflank provides public TLS; Caddy uses HTTP inside the container.
# API service name must be exactly "yonvi-api" and private port 3001.
:8080 {
    encode zstd gzip
    @backend path /api/* /health
    handle @backend {
        reverse_proxy yonvi-api:3001
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
