{
    admin off
    auto_https off
}
:{$PORT:10000} {
    encode zstd gzip
    @backend path /api/* /health
    handle @backend {
        reverse_proxy 127.0.0.1:3001
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
