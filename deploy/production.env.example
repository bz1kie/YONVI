# Copy to .env.production on the VPS. Never commit real secrets.
YONVI_DOMAIN=example.com
POSTGRES_USER=yonvi
POSTGRES_DB=yonvi
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
MAX_YONVI_TOKEN=REPLACE_WITH_REAL_BOT_TOKEN
